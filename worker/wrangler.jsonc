// Cloudflare Workers: portal de estudiantes + API pública (/api/*).
// Despliegue: desde la raíz del repo, tras compilar frontend-estudiante:
//   npx wrangler deploy --config worker/wrangler.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "encuesta-estudiantes",
  "main": "src/index.js",
  "compatibility_date": "2024-11-01",

  // Portal público: se sirve el build de frontend-estudiante (raíz del dominio).
  // El despliegue por Git ejecuta antes:  npm --prefix frontend-estudiante run build
  "assets": {
    "directory": "../frontend-estudiante/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Primero llega al Worker para distinguir /api de las rutas SPA.
    "run_worker_first": true
  },

  // Variables NO secretas. Los secretos se añaden con
  //   npx wrangler secret put SUPABASE_URL     (https://xxxx.supabase.co)
  //   npx wrangler secret put SUPABASE_KEY     (anon/public key)
  // en Cloudflare: Worker → Settings → Variables and Secrets.
  "vars": {
    "PORTAL_ESTUDIANTE_PUBLICO": "true"
  },

  "observability": {
    "enabled": true
  }
}
