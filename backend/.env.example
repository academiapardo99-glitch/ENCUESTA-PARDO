# ===== Backend (.env — copiar a .env y completar) =====
# Almacén: dejar vacío para JSON local o poner "supabase".
PERSISTENCIA=supabase

# Proyecto Supabase (Settings → API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave secreta: solo en el servidor, NUNCA en el frontend.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Puerto de la API (por defecto 4000)
PORT=4000
# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
